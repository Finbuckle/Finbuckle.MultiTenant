<Project>
    <Target Name="DisplayVersion10MaintenanceFeeMessage" BeforeTargets="Build">
        <Message Importance="high" Text="As of November 10, 2026, with the release of .NET 11, Finbuckle.MultiTenant v11 and later require the Open Source Maintenance Fee for use in revenue-generating activities. Finbuckle.MultiTenant v10 does not require the fee, but users are encouraged to participate voluntarily: https://github.com/sponsors/finbuckle" />
    </Target>
</Project>
