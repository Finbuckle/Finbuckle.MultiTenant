<Project>
    <Target Name="DisplayVersion10SponsorshipMessage" BeforeTargets="Build">
        <Message Importance="high" Text="As of November 10, 2026, with the release of .NET 11, Finbuckle.MultiTenant v11 and later require the Open Source Maintenance Fee for use in revenue-generating activities. Finbuckle.MultiTenant v10 does not, but if it is useful to you please consider sponsoring its development: https://github.com/sponsors/finbuckle" />
    </Target>
</Project>
